<node id="PRC4291_M">
  <data key="d0">regulation</data>
  <data key="d3">PRC 4291 Section M</data>
  <data key="d4">10ft bare mineral soil clearance required around propane tank</data>
  <data key="d5">PRC 4291 §M</data>
</node>
<node id="PRC4291_M_ext">
  <data key="d0">regulation</data>
  <data key="d3">PRC 4291 Section M Extended</data>
  <data key="d4">Additional 10ft no flammable vegetation beyond the mineral soil ring</data>
  <data key="d5">PRC 4291 §M (extended)</data>
</node>
<node id="IBHS_Z1_propane">
  <data key="d0">regulation</data>
  <data key="d3">IBHS Wildfire Prepared Home</data>
  <data key="d4">If &gt;30ft from home is not possible, minimum 10ft clearance plus enclosed 4 sides with concrete block construction</data>
  <data key="d5">IBHS Zone 1 Propane</data>
</node>
<node id="IBHS_Z0_vehicle">
  <data key="d0">regulation</data>
  <data key="d3">IBHS Wildfire Prepared Home</data>
  <data key="d4">Do not park vehicles within 5ft of any structure</data>
  <data key="d5">IBHS Zone 0 Vehicle</data>
</node>
<node id="IBHS_redflag">
  <data key="d0">regulation</data>
  <data key="d3">IBHS Wildfire Prepared Home</data>
  <data key="d4">On red flag warning days, point vehicle toward exit and keep keys inside for rapid evacuation</data>
  <data key="d5">IBHS Red Flag Vehicle Protocol</data>
</node>
<node id="IBHS_Z0_trash_plastic">
  <data key="d0">regulation</data>
  <data key="d3">IBHS Wildfire Prepared Home</data>
  <data key="d4">Plastic trash cans in Zone 0 (0-5ft) are a combustible hazard and must be removed or replaced with metal containers</data>
  <data key="d5">IBHS Zone 0 Trash (Plastic)</data>
</node>
<node id="IBHS_Z0_trash_metal">
  <data key="d0">regulation</data>
  <data key="d3">IBHS Wildfire Prepared Home</data>
  <data key="d4">Metal trash cans are acceptable in Zone 0</data>
  <data key="d5">IBHS Zone 0 Trash (Metal)</data>
</node>
<node id="PRC4291_G">
  <data key="d0">regulation</data>
  <data key="d3">PRC 4291 Section G</data>
  <data key="d4">Relocate exposed wood pile outside Zone 1 unless fully covered with fire-resistant material</data>
  <data key="d5">PRC 4291 §G</data>
</node>
<node id="IBHS_woodpile">
  <data key="d0">regulation</data>
  <data key="d3">IBHS Wildfire Prepared Home</data>
  <data key="d4">Store firewood at least 30ft from structure; maintain 10ft bare mineral soil clearance around the pile</data>
  <data key="d5">IBHS Firewood Storage</data>
</node>
<node id="IBHS_Z1_shed">
  <data key="d0">regulation</data>
  <data key="d3">IBHS Wildfire Prepared Home</data>
  <data key="d4">Place accessory structures at least 10ft from the primary home; maintain 5ft noncombustible buffer around each structure</data>
  <data key="d5">IBHS Zone 1 Shed</data>
</node>
