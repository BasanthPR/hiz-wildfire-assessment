  <data key="d0">object</data>
  <data key="d1">firewood,woodpile,lumber stack,log pile,stacked wood</data>
  <data key="d2">Stack of firewood or lumber stored outdoors</data>
</node>
<node id="storage_shed">
  <data key="d0">object</data>
  <data key="d1">shed,outbuilding,structure</data>
