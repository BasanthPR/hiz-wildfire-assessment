  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">• Note: Meeting this requirement may necessitate coordination with neighbors or an HOA to eliminate at least one of the combustible parallel fences. 3.2.2 Detached Accessory Dwelling Units and Accessory Structures</data>
  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">structural</data>
  <data key="d13">ALL</data>
</node>
