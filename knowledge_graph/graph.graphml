  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">o Shall remove all vegetation (e.g., grass, artificial turf, weeds, flowers, succulents, cacti, plants, shrubs, bushes, and vegetative debris) within 5</data>
  <data key="d11">True</data>
  <data key="d12">CRITICAL</data>
  <data key="d10">removal</data>
  <data key="d13">Zone_0</data>
