  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">o Removal Requirement: Shall remove all combustible items within 5 feet including, but not limited to, drapes, hot tubs, outdoor kitchens, bars, built-ins, firewood, furniture, hanging lamps, window-mounted AC units, large area rugs, combustible privacy dividers, plastic rain barrels, wine barrels, wood planters, playsets, saunas, sheds, storage containers, shade screens, and retractable shade scr</data>
  <data key="d11">True</data>
  <data key="d12">CRITICAL</data>
