  <data key="d11">True</data>
  <data key="d12">CRITICAL</data>
  <data key="d10">material</data>
  <data key="d13">Zone_0</data>
</node>
<node id="IBHS_Z1_003">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">o Designations cannot be granted for homes under active construction. All home components and defensible space requirements shall be complete to receive designation. 2025 Wildfire Prepared Home™ Technical Standard 5 1.2 Red Flag Warning and Extended Absence Preparedness</data>
  <data key="d11">False</data>
  <data key="d12">HIGH</data>
  <data key="d10">structural</data>
  <data key="d13">Zone_1</data>
