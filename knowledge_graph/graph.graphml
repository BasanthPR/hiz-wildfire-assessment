  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">After creating an account, log in at wildfireprepared.org/portal to ask questions and check your application status. 4.3 Definitions</data>
  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">structural</data>
  <data key="d13">ALL</data>
</node>
