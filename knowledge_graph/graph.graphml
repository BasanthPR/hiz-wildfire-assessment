  <data key="d7">IBHS_WFPH</data>
  <data key="d8">• Option 1: New Construction - All deck components, including posts, joists, railings, stairs, and walking surfaces, shall be constructed with noncombustible materials.</data>
  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">material</data>
