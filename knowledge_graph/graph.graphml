  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">structural</data>
  <data key="d13">ALL</data>
</node>
<node id="IBHS_ZA_163">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">• Doors made of combustible material (e.g. non-solid core wood doors) are permissible provided a noncombustible exterior storm door is installed as the outermost door. 2025 Wildfire Prepared Home™ Technical Standard 13 3.1.7 Decks and Stairs</data>
  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">material</data>
  <data key="d13">ALL</data>
</node>
