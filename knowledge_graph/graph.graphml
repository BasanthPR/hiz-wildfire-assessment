  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">To meet the wildfire mitigation requirements for a designation, use the How-To Prepare My Home Checklist to ensure all the necessary steps for your chosen level are complete before applying. 4.2 IBHS Portal, Contact Information, and Status Updates</data>
  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">structural</data>
  <data key="d13">ALL</data>
</node>
