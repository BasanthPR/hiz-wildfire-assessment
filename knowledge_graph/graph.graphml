</node>
<node id="IBHS_Z0_019">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">o Shall remove combustible fencing materials (e.g., wood and vinyl), posts, gates, and retaining walls within 5 feet or replace with noncombustible material.</data>
  <data key="d11">False</data>
  <data key="d12">CRITICAL</data>
  <data key="d10">removal</data>
  <data key="d13">Zone_0</data>
</node>
<node id="IBHS_Z0_020">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">o Shall not store vehicles, motorcycles, trailers, boats, campers, RVs, ATVs, and similar vehicles within 5 feet. Relocate them at least 30 feet away on Red Flag Warning days or during extended absences.</data>
  <data key="d11">True</data>
  <data key="d12">CRITICAL</data>
  <data key="d10">removal</data>
  <data key="d13">Zone_0</data>
