  <data key="d8">Address numbers shall be displayed in contrasting colors (4 inch minimum size) and readable from the street or access road.</data>
  <data key="d13">ALL</data>
  <data key="d15">N</data>
  <data key="d10">structural</data>
  <data key="d12">LOW</data>
  <data key="d11">True</data>
</node>
<node id="CALFIRE_Z2_O">
  <data key="d0">regulation</data>
  <data key="d7">CALFIRE_LE100A</data>
  <data key="d8">Equip chimney or stovepipe openings with a metal screen having openings between 3/8 inch and 1/2 inch.</data>
  <data key="d13">ALL</data>
  <data key="d15">O</data>
  <data key="d10">structural</data>
  <data key="d12">HIGH</data>
  <data key="d11">False</data>
</node>
<node id="CALFIRE_Z0_001">
  <data key="d0">regulation</data>
  <data key="d7">CALFIRE_LE100A</data>
  <data key="d8">Eliminate flammable materials and vegetation in the 0–5 foot ember-resistant zone. This zone is critical for protecting homes during wildfires.</data>
  <data key="d13">Zone_0</data>
  <data key="d15">Z0-Ember</data>
  <data key="d10">removal</data>
  <data key="d12">CRITICAL</data>
  <data key="d11">True</data>
</node>
<node id="CALFIRE_Z0_002">
  <data key="d0">regulation</data>
  <data key="d7">CALFIRE_LE100A</data>
  <data key="d8">Roof shall be the highest priority for ignition-resistant materials (Class A roofing). Roof and eaves/soffits shall use ignition-resistant construction.</data>
  <data key="d13">Zone_0</data>
  <data key="d15">Z0-Roof</data>
  <data key="d10">material</data>
  <data key="d12">CRITICAL</data>
  <data key="d11">False</data>
</node>
<node id="CALFIRE_Z0_003">
  <data key="d0">regulation</data>
  <data key="d7">CALFIRE_LE100A</data>
  <data key="d8">Cover and protect all vent openings to prevent ember intrusion. Vents shall be covered with fine mesh screening.</data>
  <data key="d13">Zone_0</data>
  <data key="d15">Z0-Vents</data>
  <data key="d10">structural</data>
  <data key="d12">CRITICAL</data>
  <data key="d11">False</data>
</node>
<node id="CALFIRE_Z0_004">
  <data key="d0">regulation</data>
  <data key="d7">CALFIRE_LE100A</data>
  <data key="d8">Install dual-paned windows and protect against blow-outs during wildfire.</data>
  <data key="d13">Zone_0</data>
  <data key="d15">Z0-Windows</data>
  <data key="d10">structural</data>
  <data key="d12">CRITICAL</data>
  <data key="d11">False</data>
</node>
<node id="CALFIRE_Z0_005">
  <data key="d0">regulation</data>
  <data key="d7">CALFIRE_LE100A</data>
  <data key="d8">Screen or enclose rain gutters to prevent vegetative debris accumulation that could ignite from embers.</data>
  <data key="d13">Zone_0</data>
  <data key="d15">Z0-Gutters</data>
  <data key="d10">structural</data>
  <data key="d12">CRITICAL</data>
  <data key="d11">False</data>
</node>
<node id="CALFIRE_Z0_006">
  <data key="d0">regulation</data>
  <data key="d7">CALFIRE_LE100A</data>
  <data key="d8">Cover chimney outlets with non-combustible screens to prevent ember escape or entry.</data>
  <data key="d13">Zone_0</data>
  <data key="d15">Z0-Chimney</data>
  <data key="d10">structural</data>
  <data key="d12">CRITICAL</data>
  <data key="d11">False</data>
</node>
<node id="CALFIRE_Z0_007">
  <data key="d0">regulation</data>
  <data key="d7">CALFIRE_LE100A</data>
  <data key="d8">Ensure driveway access to your home complies with local fire codes to allow emergency vehicle access.</data>
  <data key="d13">ALL</data>
  <data key="d15">Z0-Driveway</data>
  <data key="d10">structural</data>
  <data key="d12">MEDIUM</data>
  <data key="d11">True</data>
</node>
<node id="CALFIRE_Z0_008">
  <data key="d0">regulation</data>
  <data key="d7">CALFIRE_LE100A</data>
  <data key="d8">Have multiple garden hoses that are long enough to reach all areas of your home for fire suppression.</data>
  <data key="d13">ALL</data>
  <data key="d15">Z0-Water</data>
  <data key="d10">structural</data>
  <data key="d12">MEDIUM</data>
  <data key="d11">False</data>
</node>
