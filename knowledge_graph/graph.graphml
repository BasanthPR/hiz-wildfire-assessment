  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">Back-to-back (parallel) combustible fencing (meaning separate fences that are combustible and closer than 5 feet apart) are not permitted.</data>
  <data key="d11">True</data>
  <data key="d12">LOW</data>
  <data key="d10">structural</data>
  <data key="d13">ALL</data>
</node>
