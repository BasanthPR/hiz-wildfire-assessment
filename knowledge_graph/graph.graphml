  <data key="d13">Zone_0</data>
</node>
<node id="IBHS_Z0_017">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">o Shall remove all trees, limbs, branches, and vines that are within and that overhang the 0–5 Foot</data>
  <data key="d11">True</data>
  <data key="d12">CRITICAL</data>
  <data key="d10">removal</data>
  <data key="d13">Zone_0</data>
</node>
<node id="IBHS_Z0_018">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">o Shall remove all combustible groundcover materials (e.g., wood and rubber mulch and exposed weed cloth) within 5 feet to bare mineral soil.</data>
  <data key="d11">False</data>
  <data key="d12">CRITICAL</data>
  <data key="d10">removal</data>
  <data key="d13">Zone_0</data>
</node>
<node id="IBHS_ZA_107">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">• Note: Noncombustible hardscape materials (e.g., gravel, pavers, river rocks, decomposed granite, steppingstones, and concrete) are permitted.</data>
  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">material</data>
  <data key="d13">ALL</data>
</node>
