  <data key="d13">ALL</data>
</node>
<node id="IBHS_ZA_173">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">o The area underneath shall be enclosed with noncombustible, corrosion-resistant mesh with openings not to exceed 1/ -inch in diameter. 8</data>
  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">material</data>
  <data key="d13">ALL</data>
</node>
<node id="IBHS_ZA_174">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">o A minimum of 6-inches of noncombustible material (e.g., metal flashing or fiber-cement) shall be applied vertically at the exterior base, measured from the ground at grade.</data>
  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">material</data>
  <data key="d13">ALL</data>
</node>
