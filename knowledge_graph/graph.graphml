<node id="IBHS_ZA_047">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">To help protect your home during Red Flag Warning days and during extended absences, take the following maintenance steps:</data>
  <data key="d11">False</data>
  <data key="d12">LOW</data>
  <data key="d10">structural</data>
  <data key="d13">ALL</data>
</node>
<node id="IBHS_Z0_007">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">• 0–5 Foot Noncombustible Zone – Clear all accumulated vegetative debris and combustible items from this critical area.</data>
  <data key="d11">True</data>
  <data key="d12">CRITICAL</data>
  <data key="d10">material</data>
  <data key="d13">Zone_0</data>
