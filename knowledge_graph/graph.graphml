  <data key="d13">ALL</data>
</node>
<node id="IBHS_ZA_081">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">• A limited number of items including, but not limited to, door mats, string lights, TVs, speakers, bird feeders, ceiling fans, pet doors and beds, trash/recycle bins, kids’ toys, pool accessories, decorations, garden hoses, and BBQ grills with propane tank and covers are permitted.</data>
  <data key="d11">True</data>
  <data key="d12">LOW</data>
