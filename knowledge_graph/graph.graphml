  <data key="d7">IBHS_WFPH</data>
  <data key="d8">All exterior windows, skylights, and glazed openings within doors shall comply with one of the following requirements:</data>
  <data key="d11">True</data>
  <data key="d12">LOW</data>
  <data key="d10">structural</data>
  <data key="d13">ALL</data>
</node>
