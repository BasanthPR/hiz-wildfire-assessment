  <data key="d13">Zone_1</data>
</node>
<node id="IBHS_ZA_034">
  <data key="d0">regulation</data>
  <data key="d7">IBHS_WFPH</data>
  <data key="d8">• Regularly maintain all decks and porches.</data>
  <data key="d11">True</data>
  <data key="d12">LOW</data>
  <data key="d10">clearance</data>
  <data key="d13">ALL</data>
</node>
<node id="IBHS_ZA_035">
  <data key="d0">regulation</data>
